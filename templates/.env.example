# === Lark App credentials (Required) ===
# How to get: docs/lark-api-setup.md
LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Lark domain (default: international)
# Use 'feishu.cn' if your tenant is on feishu.cn
LARK_DOMAIN=larksuite.com

# === Lark Wiki target (Required) ===
# Get from URL: https://<tenant>.larksuite.com/wiki/space/<SPACE_ID>
WIKI_SPACE_ID={{WIKI_SPACE_ID}}

# Optional: Node ID of INDEX page (canonical TOC)
WIKI_INDEX_NODE={{WIKI_INDEX_NODE_ID}}

# === Lark Base sync (Optional) ===
# For sync_index_base.py
LARK_BASE_APP_TOKEN={{LARK_BASE_APP_TOKEN}}
LARK_INDEX_TABLE_ID=

# === v2.0 — AI Reviewer Bot (not used in v1) ===
# ANTHROPIC_API_KEY=
# WIKI_REVIEWER_MODEL=claude-opus-4-7
# REVIEWER_WEBHOOK_SECRET=
